---
import BaseLayout from '../../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "@id": "https://rubenspessoa.dev/#person",
    "name": "Rubens Pessoa",
    "url": "https://rubenspessoa.dev/",
    "image": "https://rubenspessoa.dev/images/1753387860689.jpeg",
    "jobTitle": "Founder",
    "description": "Independent founder building apps for iPhone, iPad, and Mac.",
    "email": "mailto:contact@rubenspessoa.dev",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Graz",
      "addressCountry": "AT"
    },
    "sameAs": [
      "https://github.com/rubenspessoa",
      "https://www.linkedin.com/in/rubenspbf/",
      "https://x.com/rubenspbf",
      "https://apps.apple.com/us/developer/rubens-pessoa-de-barros-filho/id1703452695?uo=4"
    ]
  }
};
---

<BaseLayout
  title="About | Rubens Pessoa"
  description="Rubens Pessoa is an independent founder in Graz, Austria, making apps for iPhone, iPad, and Mac."
  canonicalUrl="https://rubenspessoa.dev/about/"
  jsonLd={jsonLd}
>
  <article class="prose-page">
    <img
      class="about-portrait"
      src="/images/1753387860689.jpeg"
      alt="Portrait of Rubens Pessoa"
      width="256"
      height="256"
      loading="eager"
      decoding="async"
    >

    <p class="kicker">About</p>
    <h1>Hi, I&rsquo;m Rubens.</h1>

    <div class="prose">
      <p>
        I&rsquo;m a Brazilian founder living in Graz, Austria. I make apps for iPhone, iPad, and
        Mac, and I do everything myself: the design, the code, and the support inbox.
      </p>
      <p>
        I keep the apps small on purpose. Each one does a single job, and I&rsquo;d rather ship
        something narrow that works than something broad that sort of does. Working alone also
        means there&rsquo;s nobody else to blame when a detail is off, which turns out to be
        excellent motivation for getting the details right.
      </p>
      <p>
        Outside of work I&rsquo;m usually on a bike, on skis I&rsquo;m still learning to trust,
        or playing the guitar I never quite put down after years in a band. I&rsquo;m married to
        a brilliant engineer, so home is basically a happy nerdy two-person lab.
      </p>
      <p>
        Questions about the apps, or just want to say hi? Write me at
        <a href="mailto:contact@rubenspessoa.dev">contact@rubenspessoa.dev</a>.
      </p>
    </div>
  </article>
</BaseLayout>
