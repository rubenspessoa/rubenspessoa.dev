---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://rubenspessoa.dev/#person",
      "name": "Rubens Pessoa",
      "url": "https://rubenspessoa.dev/",
      "image": "https://rubenspessoa.dev/images/1753387860689.jpeg",
      "jobTitle": "Apple app engineer",
      "description": "Apple app engineer building native apps for iPhone, iPad, and Mac with SwiftUI and AI.",
      "email": "mailto:contact@rubenspessoa.dev",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://rubenspessoa.dev/"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Graz",
        "addressCountry": "AT"
      },
      "sameAs": [
        "https://github.com/rubenspessoa",
        "https://www.linkedin.com/in/rubenspbf/",
        "https://x.com/rubenspbf",
        "https://apps.apple.com/us/developer/rubens-pessoa-de-barros-filho/id1703452695?uo=4",
        "https://www.hustlrr.ai/",
        "https://rubenspessoa.github.io/nitpickr/"
      ],
      "knowsAbout": [
        "AI-powered mobile apps",
        "SwiftUI",
        "iOS development",
        "macOS development",
        "Apple platform engineering",
        "Developer tools",
        "Frontend development",
        "Backend development"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://rubenspessoa.dev/#website",
      "url": "https://rubenspessoa.dev/",
      "name": "Rubens Pessoa",
      "alternateName": "Rubens Pessoa — Apple App Engineer",
      "description": "Portfolio site for Rubens Pessoa, an Apple app engineer.",
      "publisher": {
        "@id": "https://rubenspessoa.dev/#person"
      }
    }
  ]
};
---

<BaseLayout
  title="Rubens Pessoa — Apple App Engineer"
  description="Rubens Pessoa builds native apps for iPhone, iPad, and Mac with SwiftUI, integrating AI features and shipping through the App Store."
  canonicalUrl="https://rubenspessoa.dev/"
  ogTitle="Rubens Pessoa — Apple App Engineer"
  ogDescription="Native apps for Apple platforms. SwiftUI, AI features, App Store delivery."
  isHome={true}
  mainId="top"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">Apple app engineer</p>
        <h1>Native apps for Apple platforms, and everything around them.</h1>
        <p class="hero__lede">
          I go deepest in SwiftUI and UIKit, but I build the full stack when the product needs it:
          backends, web frontends, AI features, and the infrastructure to ship.
        </p>

        <div class="hero__actions">
          <a class="text-link" href="#work">
            <span>See selected work</span>
            <svg class="button__icon" viewBox="0 0 5.49989 9.49989" aria-hidden="true">
              <use href="#icon-chevron-right"></use>
            </svg>
          </a>
        </div>
      </div>

      <div class="hero__visual reveal" data-reveal>
        <div class="hero__halo" aria-hidden="true"></div>

        <figure class="hero-phone hero-phone--left">
          <div class="hero-phone__screen">
            <img
              src="/images/screenshots/giorni-hero.jpg"
              alt="Giorni app screenshot"
              width="645"
              height="1400"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            >
          </div>
        </figure>

        <figure class="hero-phone hero-phone--center">
          <div class="hero-phone__screen">
            <img
              src="/images/screenshots/hustlrr-hero.jpg"
              alt="Hustlrr app screenshot"
              width="645"
              height="1400"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            >
          </div>
        </figure>

        <figure class="hero-phone hero-phone--right">
          <div class="hero-phone__screen">
            <img
              src="/images/screenshots/arbora-hero.jpg"
              alt="Arbora app screenshot"
              width="645"
              height="1400"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            >
          </div>
        </figure>

        <div class="hero-tool">
          <img
            class="hero-tool__mark"
            src="/images/nitpickr/nitpickr-flying.png"
            alt=""
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
          >
          <div class="hero-tool__copy">
            <strong>Nitpickr</strong>
            <span>AI PR review tool</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="section">
    <div class="section-heading section-heading--split reveal" data-reveal>
      <div class="section-heading__copy">
        <p class="eyebrow">Work</p>
        <h2>Products I&apos;ve built.</h2>
        <p>A mix of personal products, client work, and tools.</p>
      </div>
    </div>

    <div class="product-grid">
      <article class="product-card product-card--wide product-card--coming reveal" data-reveal>
        <span class="product-card__banner">Coming soon</span>

        <div class="product-card__body">
          <div class="product-card__copy">
            <div class="product-card__top">
              <img
                class="app-icon"
                src="/images/apps/arbora-icon.png"
                alt="Arbora app icon"
                width="128"
                height="128"
                loading="lazy"
                decoding="async"
              >
              <div class="product-card__intro">
                <p class="card-kicker">AI plant app / In progress</p>
                <h3>Arbora</h3>
              </div>
            </div>

            <p class="product-card__summary">
              AI plant identification and care app in progress, built to make diagnosis, guidance, and follow-up
              simple for everyday plant owners.
            </p>
          </div>

          <div class="phone-strip phone-strip--placeholder" aria-hidden="true">
            <div class="phone-frame phone-frame--placeholder">
              <span class="phone-placeholder phone-placeholder--chip"></span>
              <span class="phone-placeholder phone-placeholder--hero"></span>
              <span class="phone-placeholder phone-placeholder--line"></span>
              <span class="phone-placeholder phone-placeholder--line phone-placeholder--line-short"></span>
            </div>
            <div class="phone-frame phone-frame--placeholder">
              <span class="phone-placeholder phone-placeholder--chip"></span>
              <span class="phone-placeholder phone-placeholder--hero"></span>
              <span class="phone-placeholder phone-placeholder--line"></span>
              <span class="phone-placeholder phone-placeholder--line phone-placeholder--line-short"></span>
            </div>
            <div class="phone-frame phone-frame--placeholder">
              <span class="phone-placeholder phone-placeholder--chip"></span>
              <span class="phone-placeholder phone-placeholder--hero"></span>
              <span class="phone-placeholder phone-placeholder--line"></span>
              <span class="phone-placeholder phone-placeholder--line phone-placeholder--line-short"></span>
            </div>
          </div>
        </div>
      </article>

      <article class="product-card product-card--wide product-card--hustlrr reveal" data-reveal>
        <div class="product-card__body">
          <div class="product-card__copy">
            <div class="product-card__top">
              <img
                class="app-icon"
                src="/images/apps/hustlrr-icon.jpg"
                alt="Hustlrr app icon"
                width="512"
                height="512"
                loading="lazy"
                decoding="async"
              >
              <div class="product-card__intro">
                <p class="card-kicker">AI app / iPhone, iPad, Mac</p>
                <h3>Hustlrr</h3>
              </div>
            </div>

            <p class="product-card__summary">
              Multi-model AI chat app built natively for Apple devices, with Liquid Glass UI, document uploads,
              voice input, side-by-side answers, and iCloud sync.
            </p>

            <div class="product-card__actions">
              <a
                class="app-store-link"
                href="https://apps.apple.com/us/app/hustlrr-question-ai-chat/id6737912223?uo=4"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Download Hustlrr on the App Store"
              >
                <img
                  src="/images/apps/app-store-badge.svg"
                  alt="Download on the App Store"
                  width="120"
                  height="40"
                  loading="lazy"
                  decoding="async"
                >
              </a>
              <a class="text-link" href="/case-studies/hustlrr/">
                <span>Case study</span>
              </a>
              <a
                class="text-link"
                href="https://www.hustlrr.ai/"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Website</span>
                <svg class="link-icon link-icon--external" viewBox="0 0 20 20" aria-hidden="true">
                  <use href="#icon-arrow-up-right"></use>
                </svg>
              </a>
            </div>
          </div>

          <div class="phone-strip">
            <a class="phone-frame" href="https://apps.apple.com/us/app/hustlrr-question-ai-chat/id6737912223?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Hustlrr on the App Store">
              <img src="/images/apps/hustlrr-screen-1.webp" alt="Hustlrr screenshot showing the AI chat interface" width="600" height="1300" loading="lazy" decoding="async">
            </a>
            <a class="phone-frame" href="https://apps.apple.com/us/app/hustlrr-question-ai-chat/id6737912223?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Hustlrr on the App Store">
              <img src="/images/apps/hustlrr-screen-2.webp" alt="Hustlrr screenshot showing different AI models" width="600" height="1300" loading="lazy" decoding="async">
            </a>
            <a class="phone-frame" href="https://apps.apple.com/us/app/hustlrr-question-ai-chat/id6737912223?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Hustlrr on the App Store">
              <img src="/images/apps/hustlrr-screen-3.webp" alt="Hustlrr screenshot showing prompt templates" width="600" height="1300" loading="lazy" decoding="async">
            </a>
          </div>
        </div>
      </article>

      <article class="product-card product-card--wide product-card--giorni reveal" data-reveal>
        <div class="product-card__body">
          <div class="product-card__copy">
            <div class="product-card__top">
              <img
                class="app-icon"
                src="/images/apps/giorni-icon.jpg"
                alt="Giorni app icon"
                width="512"
                height="512"
                loading="lazy"
                decoding="async"
              >
              <div class="product-card__intro">
                <p class="card-kicker">Habit app / App Store</p>
                <h3>Giorni</h3>
              </div>
            </div>

            <p class="product-card__summary">
              Habit tracker built around simple daily use, with focus sessions, widgets, iCloud sync, and a
              cleaner path back into the routine.
            </p>

            <div class="product-card__actions">
              <a
                class="app-store-link"
                href="https://apps.apple.com/us/app/daily-habit-tracker-giorni/id6505112435?uo=4"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Download Giorni on the App Store"
              >
                <img
                  src="/images/apps/app-store-badge.svg"
                  alt="Download on the App Store"
                  width="120"
                  height="40"
                  loading="lazy"
                  decoding="async"
                >
              </a>
              <a class="text-link" href="/case-studies/giorni/">
                <span>Case study</span>
              </a>
            </div>
          </div>

          <div class="phone-strip">
            <a class="phone-frame" href="https://apps.apple.com/us/app/daily-habit-tracker-giorni/id6505112435?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Giorni on the App Store">
              <img src="/images/apps/giorni-screen-1.png" alt="Giorni screenshot showing the daily habits overview" width="392" height="696" loading="lazy" decoding="async">
            </a>
            <a class="phone-frame" href="https://apps.apple.com/us/app/daily-habit-tracker-giorni/id6505112435?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Giorni on the App Store">
              <img src="/images/apps/giorni-screen-2.png" alt="Giorni screenshot showing progress and tracking" width="392" height="696" loading="lazy" decoding="async">
            </a>
            <a class="phone-frame" href="https://apps.apple.com/us/app/daily-habit-tracker-giorni/id6505112435?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Giorni on the App Store">
              <img src="/images/apps/giorni-screen-3.png" alt="Giorni screenshot showing focus and check-in flows" width="392" height="696" loading="lazy" decoding="async">
            </a>
          </div>
        </div>
      </article>

      <article class="product-card product-card--wide product-card--appelou reveal" data-reveal>
        <div class="product-card__body">
          <div class="product-card__copy">
            <div class="product-card__top">
              <img
                class="app-icon"
                src="/images/apps/appelou-icon.jpg"
                alt="Appelou app icon"
                width="512"
                height="512"
                loading="lazy"
                decoding="async"
              >
              <div class="product-card__intro">
                <p class="card-kicker">Brazil App Store / Shopping app</p>
                <h3>Appelou</h3>
              </div>
            </div>

            <p class="product-card__summary">
              Real-time local price comparison app for shoppers in Alagoas, built to help people find better
              deals nearby with less friction.
            </p>

            <div class="product-card__actions">
              <a
                class="app-store-link"
                href="https://apps.apple.com/br/app/pre%C3%A7o-da-hora-alagoas-appelou/id6462813081?uo=4"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Download Appelou on the App Store"
              >
                <img
                  src="/images/apps/app-store-badge.svg"
                  alt="Download on the App Store"
                  width="120"
                  height="40"
                  loading="lazy"
                  decoding="async"
                >
              </a>
            </div>
          </div>

          <div class="phone-strip">
            <a class="phone-frame" href="https://apps.apple.com/br/app/pre%C3%A7o-da-hora-alagoas-appelou/id6462813081?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Appelou on the App Store">
              <img src="/images/apps/appelou-screen-1.png" alt="Appelou screenshot showing the price comparison interface" width="392" height="696" loading="lazy" decoding="async">
            </a>
            <a class="phone-frame" href="https://apps.apple.com/br/app/pre%C3%A7o-da-hora-alagoas-appelou/id6462813081?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Appelou on the App Store">
              <img src="/images/apps/appelou-screen-2.png" alt="Appelou screenshot showing nearby product results" width="392" height="696" loading="lazy" decoding="async">
            </a>
            <a class="phone-frame" href="https://apps.apple.com/br/app/pre%C3%A7o-da-hora-alagoas-appelou/id6462813081?uo=4" target="_blank" rel="noopener noreferrer" aria-label="Open Appelou on the App Store">
              <img src="/images/apps/appelou-screen-3.png" alt="Appelou screenshot showing additional shopping details" width="392" height="696" loading="lazy" decoding="async">
            </a>
          </div>
        </div>
      </article>

      <article class="product-card product-card--wide product-card--tool reveal" data-reveal>
        <div class="product-card__body">
          <div class="product-card__copy">
            <div class="product-card__top">
              <img
                class="app-icon app-icon--tool"
                src="/images/nitpickr/nitpickr-flying.png"
                alt="Nitpickr mascot icon"
                width="512"
                height="512"
                loading="lazy"
                decoding="async"
              >
              <div class="product-card__intro">
                <p class="card-kicker">Developer tool</p>
                <h3>Nitpickr</h3>
              </div>
            </div>

            <p class="product-card__summary">
              Source-available AI PR review for GitHub, built to keep the model, rules, and runtime under your
              control.
            </p>

            <div class="product-card__actions">
              <a
                class="text-link"
                href="https://rubenspessoa.github.io/nitpickr/"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Website</span>
                <svg class="link-icon link-icon--external" viewBox="0 0 20 20" aria-hidden="true">
                  <use href="#icon-arrow-up-right"></use>
                </svg>
              </a>
              <a
                class="text-link"
                href="https://github.com/rubenspessoa/nitpickr"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="link-icon link-icon--platform" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9.5 18c-3 1-3-1.5-4.5-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
                  <path d="M14.5 18v-2.6c0-.7.1-1.2-.3-1.7 2.3-.3 4.8-1.1 4.8-5.1 0-1.1-.4-2.1-1-2.8.1-.3.5-1.4-.1-2.8 0 0-.8-.3-2.9 1.1a10.2 10.2 0 0 0-5.4 0C7.5 3 6.7 3.3 6.7 3.3c-.6 1.4-.2 2.5-.1 2.8-.7.7-1 1.7-1 2.8 0 4 2.4 4.8 4.8 5.1-.4.5-.4 1.1-.4 1.7V18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
                </svg>
                <span>GitHub</span>
              </a>
            </div>
          </div>

          <figure class="product-card__media product-card__media--tool">
            <img
              class="product-shot"
              src="/images/nitpickr/nitpickr-reviewing.jpg"
              alt="Nitpickr mascot reviewing code on a laptop"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            >
          </figure>
        </div>
      </article>
    </div>

    <aside class="experience-panel reveal" data-reveal>
      <p class="eyebrow">Team work</p>
      <h3>Beyond my own products</h3>
      <p>
        I have also shipped Apple-platform work with Parkside, iTranslate, Tappz, and Marchon across finance,
        healthcare, hospitality, transportation, communications, and consumer products.
      </p>
    </aside>
  </section>

  <section id="about" class="section">
    <div class="about-grid">
      <div class="section-heading reveal" data-reveal>
        <p class="eyebrow">About</p>
        <h2>More than the work.</h2>
        <p>
          I am a Brazilian expat living in Austria, building apps from Graz. Most of my work lives on Apple
          platforms, but I am also comfortable across frontend, backend, and the product decisions around the app
          when that is what it takes to ship something well.
        </p>
        <p>
          Outside work, I love cycling, I have been learning to ski, and I still play guitar after years of
          being in a band. I am married to a brilliant engineer, so home is basically a happy nerdy two-person
          lab.
        </p>

        <p>
          Available for work &mdash;
          <a class="text-link" href="mailto:contact@rubenspessoa.dev"><span>get in touch</span></a>.
        </p>

        <ul class="hero__proof">
          <li>
            <strong>9+</strong>
            <span>Years on Apple platforms</span>
          </li>
          <li>
            <strong>15+</strong>
            <span>Apps built and released</span>
          </li>
          <li>
            <strong>10M+</strong>
            <span>Downloads across shipped work</span>
          </li>
        </ul>
      </div>

      <figure class="about-card reveal" data-reveal>
        <img
          src="/images/1753387860689.jpeg"
          alt="Portrait of Rubens Pessoa"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
        >
      </figure>
    </div>
  </section>
</BaseLayout>
