---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://rubenspessoa.dev/#person",
      "name": "Rubens Pessoa",
      "url": "https://rubenspessoa.dev/",
      "image": "https://rubenspessoa.dev/images/1753387860689.jpeg",
      "jobTitle": "Founder",
      "description": "Independent founder building apps for iPhone, iPad, and Mac.",
      "email": "mailto:contact@rubenspessoa.dev",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://rubenspessoa.dev/"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Graz",
        "addressCountry": "AT"
      },
      "sameAs": [
        "https://github.com/rubenspessoa",
        "https://www.linkedin.com/in/rubenspbf/",
        "https://x.com/rubenspbf",
        "https://apps.apple.com/us/developer/rubens-pessoa-de-barros-filho/id1703452695?uo=4",
        "https://www.hustlrr.ai/",
        "https://savemycactus.rubenspessoa.dev/"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://rubenspessoa.dev/#website",
      "url": "https://rubenspessoa.dev/",
      "name": "Rubens Pessoa",
      "description": "Apps for iPhone, iPad, and Mac, made by Rubens Pessoa.",
      "publisher": {
        "@id": "https://rubenspessoa.dev/#person"
      }
    },
    {
      "@type": "SoftwareApplication",
      "name": "Save My Cactus",
      "operatingSystem": "iOS",
      "applicationCategory": "LifestyleApplication",
      "description": "AI plant care: identification, diagnosis, and a care schedule.",
      "url": "https://savemycactus.rubenspessoa.dev/",
      "image": "https://rubenspessoa.dev/images/apps/save-my-cactus-icon.png",
      "author": { "@id": "https://rubenspessoa.dev/#person" }
    },
    {
      "@type": "SoftwareApplication",
      "name": "Hustlrr",
      "operatingSystem": "iOS, iPadOS, macOS",
      "applicationCategory": "ProductivityApplication",
      "description": "The best AI models in one native app for iPhone, iPad, and Mac.",
      "url": "https://apps.apple.com/us/app/hustlrr-question-ai-chat/id6737912223",
      "image": "https://rubenspessoa.dev/images/apps/hustlrr-icon.jpg",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@id": "https://rubenspessoa.dev/#person" }
    },
    {
      "@type": "SoftwareApplication",
      "name": "Giorni",
      "operatingSystem": "iOS",
      "applicationCategory": "ProductivityApplication",
      "description": "A daily habit tracker with focus sessions, widgets, and iCloud sync.",
      "url": "https://apps.apple.com/us/app/daily-habit-tracker-giorni/id6505112435",
      "image": "https://rubenspessoa.dev/images/apps/giorni-icon.jpg",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@id": "https://rubenspessoa.dev/#person" }
    }
  ]
};
---

<BaseLayout
  title="Rubens Pessoa — Apps for iPhone, iPad, and Mac"
  description="Rubens Pessoa is an independent founder making apps for iPhone, iPad, and Mac: Save My Cactus, Hustlrr, and Giorni."
  canonicalUrl="https://rubenspessoa.dev/"
  ogTitle="Rubens Pessoa — Apps for iPhone, iPad, and Mac"
  ogDescription="Independent founder making apps for Apple devices."
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1>I make apps for iPhone, iPad, and Mac.</h1>
    <p class="hero__lede">
      Independent founder based in Graz, Austria. Small, careful apps &mdash; designed, built,
      and looked after by one person.
    </p>
  </section>

  <section id="apps" class="section">
    <h2>Apps</h2>

    <div class="app-list">
      <article class="app">
        <div class="app__head">
          <img
            class="app__icon"
            src="/images/apps/save-my-cactus-icon.png"
            alt=""
            width="128"
            height="128"
            loading="eager"
            decoding="async"
          >
          <div class="app__title">
            <h3>Save My Cactus</h3>
            <p class="app__tagline">AI plant care</p>
          </div>
        </div>

        <p class="app__summary">
          Stop killing your plants. Point your camera at a plant and know what it is, what it
          needs, and what is wrong with it &mdash; identification, diagnosis, and a care schedule
          that keeps up with your plants.
        </p>

        <div class="app__actions">
          <span class="badge">Coming soon</span>
          <a
            class="text-link"
            href="https://savemycactus.rubenspessoa.dev/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Learn more about Save My Cactus"
          >
            <span>Learn more</span>
            <svg class="link-icon" viewBox="0 0 20 20" aria-hidden="true">
              <use href="#icon-arrow-up-right"></use>
            </svg>
          </a>
        </div>
      </article>

      <article class="app">
        <div class="app__head">
          <img
            class="app__icon"
            src="/images/apps/hustlrr-icon.jpg"
            alt=""
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          >
          <div class="app__title">
            <h3>Hustlrr</h3>
            <p class="app__tagline">AI chat for Apple devices</p>
          </div>
        </div>

        <p class="app__summary">
          The best AI models in one native app for iPhone, iPad, and Mac. Compare answers side by
          side, upload documents, talk instead of type, and keep every chat in sync with iCloud.
        </p>

        <div class="app__actions">
          <a
            class="app-store-link"
            href="https://apps.apple.com/us/app/hustlrr-question-ai-chat/id6737912223?uo=4"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download Hustlrr on the App Store"
          >
            <img
              src="/images/apps/app-store-badge.svg"
              alt="Download on the App Store"
              width="120"
              height="40"
              loading="lazy"
              decoding="async"
            >
          </a>
          <a
            class="text-link"
            href="https://www.hustlrr.ai/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>hustlrr.ai</span>
            <svg class="link-icon" viewBox="0 0 20 20" aria-hidden="true">
              <use href="#icon-arrow-up-right"></use>
            </svg>
          </a>
        </div>

      </article>

      <article class="app">
        <div class="app__head">
          <img
            class="app__icon"
            src="/images/apps/giorni-icon.jpg"
            alt=""
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          >
          <div class="app__title">
            <h3>Giorni</h3>
            <p class="app__tagline">Daily habit tracker</p>
          </div>
        </div>

        <p class="app__summary">
          A habit tracker built for daily use, not guilt. Focus sessions, widgets, iCloud sync,
          and a gentle path back into the routine when you slip.
        </p>

        <div class="app__actions">
          <a
            class="app-store-link"
            href="https://apps.apple.com/us/app/daily-habit-tracker-giorni/id6505112435?uo=4"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download Giorni on the App Store"
          >
            <img
              src="/images/apps/app-store-badge.svg"
              alt="Download on the App Store"
              width="120"
              height="40"
              loading="lazy"
              decoding="async"
            >
          </a>
        </div>

      </article>
    </div>
  </section>

  <section class="section">
    <p class="also-built">
      Also made:
      <a href="https://apps.apple.com/br/app/pre%C3%A7o-da-hora-alagoas-appelou/id6462813081?uo=4" target="_blank" rel="noopener noreferrer">Appelou</a>,
      a price-comparison app for Alagoas, Brazil
      &middot;
      <a href="https://github.com/rubenspessoa/nitpickr" target="_blank" rel="noopener noreferrer">Nitpickr</a>,
      an AI code-review tool for GitHub.
    </p>
  </section>
</BaseLayout>
