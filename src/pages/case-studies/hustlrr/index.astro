---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://rubenspessoa.dev/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Hustlrr case study",
          "item": "https://rubenspessoa.dev/case-studies/hustlrr/"
        }
      ]
    },
    {
      "@type": "Article",
      "headline": "Hustlrr case study",
      "description": "A first-hand case study on building Hustlrr, a native AI chat app for Apple devices.",
      "author": {
        "@type": "Person",
        "name": "Rubens Pessoa",
        "url": "https://rubenspessoa.dev/"
      },
      "publisher": {
        "@type": "Person",
        "name": "Rubens Pessoa",
        "url": "https://rubenspessoa.dev/"
      },
      "image": "https://rubenspessoa.dev/images/seo/social-card.png",
      "datePublished": "2026-03-13",
      "dateModified": "2026-03-13",
      "mainEntityOfPage": "https://rubenspessoa.dev/case-studies/hustlrr/"
    }
  ]
};
---

<BaseLayout
  title="Hustlrr Case Study | Rubens Pessoa"
  description="Hustlrr case study: how Rubens Pessoa shipped a native AI chat app for Apple devices with strong product execution and SwiftUI-focused delivery."
  canonicalUrl="https://rubenspessoa.dev/case-studies/hustlrr/"
  ogType="article"
  mainClass="page-main"
  jsonLd={jsonLd}
>
  <article class="story-page">
    <section class="section section--page-intro">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Hustlrr case study" }]} />

      <div class="section-heading reveal" data-reveal>
        <p class="eyebrow">Case study</p>
        <h1 class="page-title">Hustlrr: building a native AI chat app for Apple devices.</h1>
        <p class="page-lede">
          Hustlrr is an AI chat product built for Apple devices. I led the product execution and engineering work
          across native UX, AI features, platform polish, and the release details needed to ship a serious app.
        </p>
      </div>

      <p class="story-meta reveal" data-reveal>
        By Rubens Pessoa &middot; <time datetime="2026-03-13">March 13, 2026</time>
      </p>
    </section>

    <section class="section">
      <div class="detail-grid">
        <article class="legal-card detail-card reveal" data-reveal>
          <p class="eyebrow">Platform</p>
          <h3>iPhone, iPad, and Mac</h3>
          <p>Native Apple-platform product work with a consistent experience across devices.</p>
        </article>

        <article class="legal-card detail-card reveal" data-reveal>
          <p class="eyebrow">Focus</p>
          <h3>AI UX and product clarity</h3>
          <p>Making multi-model AI features feel useful, understandable, and worth returning to.</p>
        </article>

        <article class="legal-card detail-card reveal" data-reveal>
          <p class="eyebrow">Role</p>
          <h3>Product and engineering</h3>
          <p>Shaping the product, building the app, and handling the delivery details around it.</p>
        </article>

        <article class="legal-card detail-card reveal" data-reveal>
          <p class="eyebrow">This shipped</p>
          <h3>Public App Store release</h3>
          <p>A real product with App Store delivery, iteration, and live native product constraints.</p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="legal-card reveal" data-reveal>
        <div class="phone-strip phone-strip--story">
          <figure class="phone-frame">
            <img
              src="/images/apps/hustlrr-screen-1.webp"
              alt="Hustlrr screenshot showing the AI chat interface"
              width="600"
              height="1300"
              loading="lazy"
              decoding="async"
            >
          </figure>
          <figure class="phone-frame">
            <img
              src="/images/apps/hustlrr-screen-2.webp"
              alt="Hustlrr screenshot showing different AI models"
              width="600"
              height="1300"
              loading="lazy"
              decoding="async"
            >
          </figure>
          <figure class="phone-frame">
            <img
              src="/images/apps/hustlrr-screen-3.webp"
              alt="Hustlrr screenshot showing prompt templates"
              width="600"
              height="1300"
              loading="lazy"
              decoding="async"
            >
          </figure>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="story-body">
        <section class="legal-card reveal" data-reveal>
          <p class="eyebrow">The challenge</p>
          <h2>AI apps get complicated fast.</h2>
          <p>
            It is easy to turn an AI chat app into a messy pile of model names, feature flags, and prompts. The
            work here was not just wiring up AI responses. It was making the app feel native, understandable, and
            calm enough that people could actually use it every day on Apple devices.
          </p>
        </section>

        <section class="legal-card reveal" data-reveal>
          <p class="eyebrow">What I shipped</p>
          <ul class="story-list">
            <li>Native AI chat flows designed for Apple devices instead of a thin wrapper around a web product.</li>
            <li>Multi-model support with product decisions around comparison and model choice.</li>
            <li>Document uploads, voice input, and side-by-side answer experiences.</li>
            <li>iCloud-backed continuity so the product feels cohesive across devices.</li>
            <li>Visual polish and release work to take the app from idea to public App Store product.</li>
          </ul>
        </section>

        <section class="legal-card reveal" data-reveal>
          <p class="eyebrow">What this shows</p>
          <ul class="story-list">
            <li>I can work on AI-powered Apple apps without letting the product collapse into feature clutter.</li>
            <li>I am comfortable shaping product decisions, not just implementing tickets.</li>
            <li>I care about native interaction quality, delivery speed, and launch-readiness in the same project.</li>
          </ul>
        </section>
      </div>
    </section>
  </article>
</BaseLayout>
