---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://rubenspessoa.dev/" },
    { "@type": "ListItem", "position": 2, "name": "SwiftUI Development", "item": "https://rubenspessoa.dev/swiftui-consulting/" }
  ]
};
---

<BaseLayout
  title="SwiftUI Development | Rubens Pessoa"
  description="SwiftUI apps built for iPhone, iPad, and Mac, shipped to the App Store. See what Rubens Pessoa has built with SwiftUI."
  canonicalUrl="https://rubenspessoa.dev/swiftui-consulting/"
  mainClass="page-main"
  jsonLd={jsonLd}
>
  <section class="section section--page-intro">
    <Breadcrumbs items={[
      { label: "Home", href: "/" },
      { label: "SwiftUI Development" }
    ]} />

    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow">SwiftUI development</p>
      <h1 class="page-title">SwiftUI apps I have built and shipped.</h1>
      <p class="page-lede">
        I have been building with SwiftUI since its early releases &mdash; across iPhone, iPad, and Mac.
        Here is some of that work.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow">What I build with SwiftUI</p>
      <h2>Modern declarative UI, shipped to the App Store.</h2>
      <p>
        Every app below uses SwiftUI as its primary UI framework. I understand both its strengths
        and the practical workarounds needed to ship production apps.
      </p>
    </div>

    <div class="detail-grid">
      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">Cross-platform native</p>
        <h3>One codebase across iPhone, iPad, and Mac</h3>
        <p>
          SwiftUI lets you share UI and logic across Apple devices while respecting each platform's
          conventions. My apps feel right on every screen size.
        </p>
      </article>

      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">Custom components</p>
        <h3>Polished custom views and interactions</h3>
        <p>
          Beyond stock components &mdash; custom SwiftUI views with smooth animations, gesture handling,
          and the visual polish that makes an app feel crafted.
        </p>
      </article>

      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">AI + SwiftUI</p>
        <h3>AI features inside SwiftUI apps</h3>
        <p>
          Streaming chat interfaces, on-device ML integration, camera-based features, and the UI patterns
          that make AI feel natural inside a native app.
        </p>
      </article>

      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">Architecture</p>
        <h3>Clean patterns for production SwiftUI</h3>
        <p>
          Observation framework, SwiftData, dependency injection, and testable architecture that keeps
          the codebase maintainable as it grows.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading section-heading--split reveal" data-reveal>
      <div class="section-heading__copy">
        <p class="eyebrow">Shipped work</p>
        <h2>Real SwiftUI apps on the App Store.</h2>
        <p>
          Built with SwiftUI, shipped to real users, maintained over time.
        </p>
      </div>
      <a
        class="section-link"
        href="https://apps.apple.com/us/developer/rubens-pessoa-de-barros-filho/id1703452695?uo=4"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>App Store profile</span>
        <svg class="link-icon link-icon--external" viewBox="0 0 20 20" aria-hidden="true">
          <use href="#icon-arrow-up-right"></use>
        </svg>
      </a>
    </div>

    <div class="detail-grid detail-grid--proof">
      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">AI app</p>
        <h3>Hustlrr</h3>
        <p>
          Multi-model AI chat app built entirely in SwiftUI for iPhone, iPad, and Mac with Liquid Glass
          UI, streaming responses, and iCloud sync.
        </p>
        <a class="text-link" href="/case-studies/hustlrr/">
          <span>Read case study</span>
          <svg class="link-icon link-icon--external" viewBox="0 0 20 20" aria-hidden="true">
            <use href="#icon-arrow-up-right"></use>
          </svg>
        </a>
      </article>

      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">Habit tracker</p>
        <h3>Giorni</h3>
        <p>
          Habit tracking app built in SwiftUI with focus sessions, widgets, iCloud sync, and daily-use
          polish.
        </p>
        <a class="text-link" href="/case-studies/giorni/">
          <span>Read case study</span>
          <svg class="link-icon link-icon--external" viewBox="0 0 20 20" aria-hidden="true">
            <use href="#icon-arrow-up-right"></use>
          </svg>
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
