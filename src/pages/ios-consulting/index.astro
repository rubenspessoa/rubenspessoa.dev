---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://rubenspessoa.dev/" },
    { "@type": "ListItem", "position": 2, "name": "iOS Development", "item": "https://rubenspessoa.dev/ios-consulting/" }
  ]
};
---

<BaseLayout
  title="iOS Development | Rubens Pessoa"
  description="iOS apps built with Swift and SwiftUI, shipped to the App Store. See what Rubens Pessoa has built for iPhone, iPad, and Mac."
  canonicalUrl="https://rubenspessoa.dev/ios-consulting/"
  mainClass="page-main"
  jsonLd={jsonLd}
>
  <section class="section section--page-intro">
    <Breadcrumbs items={[
      { label: "Home", href: "/" },
      { label: "iOS Development" }
    ]} />

    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow">iOS development</p>
      <h1 class="page-title">iOS apps I have built and shipped.</h1>
      <p class="page-lede">
        I have been building native iOS apps for over 9 years &mdash; Swift, SwiftUI, AI features, and the
        full path from first commit to App Store. Here is some of that work.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow">What I work with</p>
      <h2>Native iOS, no shortcuts.</h2>
      <p>
        Every app below was built natively with Swift and SwiftUI. No cross-platform wrappers, no web views
        pretending to be native.
      </p>
    </div>

    <div class="detail-grid">
      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">Native iOS apps</p>
        <h3>iPhone and iPad apps built with Swift and SwiftUI</h3>
        <p>
          Clean, performant native apps that follow Apple platform conventions and feel right to users.
        </p>
      </article>

      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">AI integration</p>
        <h3>AI features inside iOS apps</h3>
        <p>
          LLM integration, on-device ML, computer vision, and the product decisions around where AI
          actually improves the experience.
        </p>
      </article>

      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">Architecture</p>
        <h3>Codebases built for the long term</h3>
        <p>
          Clean separation of concerns, testable architecture, and patterns that make the app easy to
          maintain and extend.
        </p>
      </article>

      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">App Store delivery</p>
        <h3>From development to live on the App Store</h3>
        <p>
          Subscriptions, analytics, onboarding, release work, and the details that turn a build into a
          shipped product.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading section-heading--split reveal" data-reveal>
      <div class="section-heading__copy">
        <p class="eyebrow">Shipped work</p>
        <h2>Real products on the App Store.</h2>
        <p>
          Not prototypes or demos. These are apps people use, built and shipped by me.
        </p>
      </div>
      <a
        class="section-link"
        href="https://apps.apple.com/us/developer/rubens-pessoa-de-barros-filho/id1703452695?uo=4"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>App Store profile</span>
        <svg class="link-icon link-icon--external" viewBox="0 0 20 20" aria-hidden="true">
          <use href="#icon-arrow-up-right"></use>
        </svg>
      </a>
    </div>

    <div class="detail-grid detail-grid--proof">
      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">AI app</p>
        <h3>Hustlrr</h3>
        <p>
          Native AI chat app for iPhone, iPad, and Mac with multi-model support, document uploads,
          and iCloud sync.
        </p>
        <a class="text-link" href="/case-studies/hustlrr/">
          <span>Read case study</span>
          <svg class="link-icon link-icon--external" viewBox="0 0 20 20" aria-hidden="true">
            <use href="#icon-arrow-up-right"></use>
          </svg>
        </a>
      </article>

      <article class="legal-card detail-card reveal" data-reveal>
        <p class="eyebrow">Habit tracker</p>
        <h3>Giorni</h3>
        <p>
          Daily habit tracker with focus sessions, widgets, iCloud sync, and the kind of polish that
          keeps people coming back.
        </p>
        <a class="text-link" href="/case-studies/giorni/">
          <span>Read case study</span>
          <svg class="link-icon link-icon--external" viewBox="0 0 20 20" aria-hidden="true">
            <use href="#icon-arrow-up-right"></use>
          </svg>
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
