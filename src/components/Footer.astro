---
import { ui, localeNames, pathForLocale, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = ui[locale];
const currentPath = Astro.url.pathname;
const locales = Object.keys(localeNames) as Locale[];
---

<footer class="site-footer">
  <div class="footer-links" aria-label="Footer links">
    <a class="footer-link" href="mailto:contact@rubenspessoa.dev">contact@rubenspessoa.dev</a>
    <a
      class="footer-link"
      href="https://www.linkedin.com/in/rubenspbf/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 17.5 17.5" aria-hidden="true">
        <use href="#icon-linkedin"></use>
      </svg>
      <span>LinkedIn</span>
    </a>
    <a
      class="footer-link"
      href="https://github.com/rubenspessoa"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.5 18c-3 1-3-1.5-4.5-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
        <path d="M14.5 18v-2.6c0-.7.1-1.2-.3-1.7 2.3-.3 4.8-1.1 4.8-5.1 0-1.1-.4-2.1-1-2.8.1-.3.5-1.4-.1-2.8 0 0-.8-.3-2.9 1.1a10.2 10.2 0 0 0-5.4 0C7.5 3 6.7 3.3 6.7 3.3c-.6 1.4-.2 2.5-.1 2.8-.7.7-1 1.7-1 2.8 0 4 2.4 4.8 4.8 5.1-.4.5-.4 1.1-.4 1.7V18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
      </svg>
      <span>GitHub</span>
    </a>
    <a
      class="footer-link"
      href="https://x.com/rubenspbf"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"></path>
      </svg>
      <span>X</span>
    </a>
    <a
      class="footer-link"
      href="https://apps.apple.com/us/developer/rubens-pessoa-de-barros-filho/id1703452695?uo=4"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <use href="#icon-arrow-up-right"></use>
      </svg>
      <span>App Store</span>
    </a>
  </div>

  <div class="footer-links">
    <a href="/privacy/">{t.footer.privacy}</a>
    <a href="/terms/">{t.footer.terms}</a>
    <a href="/imprint/">{t.footer.imprint}</a>
    <span>{t.footer.builtIn}</span>
  </div>

  <div class="footer-links">
    <nav class="footer-links lang-switch" aria-label="Language">
      {locales.map((l) => (
        <a href={pathForLocale(currentPath, l)} aria-current={l === locale ? 'true' : undefined} lang={l === 'pt-br' ? 'pt-BR' : l}>
          {localeNames[l]}
        </a>
      ))}
    </nav>
    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      data-labels={JSON.stringify(t.footer.themeLabels)}
      data-name={t.footer.themeName}
    ></button>
  </div>
</footer>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const labels = JSON.parse(btn.dataset.labels);
    const name = btn.dataset.name;
    const order = ['auto', 'light', 'dark'];
    const root = document.documentElement;
    const current = () => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : 'auto';
      } catch {
        return 'auto';
      }
    };
    const apply = (v) => {
      if (v === 'auto') delete root.dataset.theme;
      else root.dataset.theme = v;
      btn.textContent = `${name}: ${labels[v]}`;
    };
    apply(current());
    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(current()) + 1) % order.length];
      try {
        if (next === 'auto') localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {}
      apply(next);
    });
  })();
</script>
