---
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SvgSprite from '../components/SvgSprite.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: string;
  robots?: string;
  jsonLd?: object;
  mainClass?: string;
  mainId?: string;
  shellClass?: string;
  isHome?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogImage = 'https://rubenspessoa.dev/images/seo/social-card.png',
  ogImageAlt = 'Portrait of Rubens Pessoa beside the text Apple apps, AI products, and the engineering around them.',
  twitterCard = 'summary_large_image',
  robots = 'index,follow,max-image-preview:large',
  jsonLd,
  mainClass,
  mainId,
  shellClass,
  isHome = false,
} = Astro.props;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="author" content="Rubens Pessoa">
    <meta name="robots" content={robots}>
    <meta name="theme-color" content="#f1f6f3">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="Rubens Pessoa">
    <meta property="og:title" content={resolvedOgTitle}>
    <meta property="og:description" content={resolvedOgDescription}>
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={ogImageAlt}>
    <meta name="twitter:card" content={twitterCard}>
    <meta name="twitter:title" content={resolvedOgTitle}>
    <meta name="twitter:description" content={resolvedOgDescription}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={ogImageAlt}>
    <link rel="canonical" href={canonicalUrl}>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#10161d">
    <link rel="manifest" href="/site.webmanifest">
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Manrope:wght@400;500;600;700;800&display=swap">
    <title>{title}</title>
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <SvgSprite />
    <div class:list={["page-shell", shellClass]}>
      <Header isHome={isHome} />
      <main id={mainId} class={mainClass}>
        <slot />
      </main>
      <Footer isHome={isHome} />
    </div>
    <script is:inline src="/scripts/site.js"></script>
  </body>
</html>
